--- !u!114 &1859877461
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1859877460}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a3fb458accc05b941b9118bb4715ff0f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tipoInteracao: 2
  indicadorInteracao: {fileID: 0}
  nomeCenaDestino: 
  animatorPersonagemEmCena: {fileID: 1859877463}
  triggerAnimacao: Interact
  painelDialogo: {fileID: 0}
  textoDialogo: {fileID: 0}
  falas: []
  perguntaID: 004
  questionPanel: {fileID: 1882672981}
  questionText: {fileID: 2145058933}
  enunciadoPergunta: "Ol\xE1! Eu sou a Sabrina. Pelo visto, veio atr\xE1s do pr\xEAmio,
    ein. Bom, \xE9 uma pergunta simples, voc\xEA j\xE1 deve saber a essa altura,
    ent\xE3o vamos l\xE1:\nQuais s\xE3o os principais materiais para a cria\xE7\xE3o
    de carimbos? "
  resposta1: {fileID: 1501210133}
  resposta2: {fileID: 824704458}
  resposta3: {fileID: 1596634653}
  textoResposta1: {fileID: 1407862813}
  textoResposta2: {fileID: 646976247}
  textoResposta3: {fileID: 67945581}
  alternativa1: Borracha, EVA e madeira.
  alternativa2: Cimento ou pedra.
  alternativa3: "L\xE1pis de cor."
  alternativaCorreta: 1
  feedbackPanel: {fileID: 1626690590}
  feedbackText: {fileID: 860332597}
  textoAcerto: "Muito bem! Resposta corret\xEDssima. Comunalmente, esses s\xE3o os
    materiais mais utilzados por gravuristas para a confec\xE7\xE3o de carimbos.
    \nComo pr\xEAmio, irei te dar um de meus carimbos. Voce pode usar os itens obtidos
    na sala de BID do DAVD, ent\xE3o passa l\xE1 quando terminar as coisas por aqui."
  textoErro: "Que pena! voc\xEA errou. Mas, estarei aqui caso queira tentar novamente.\nAcredito
    que voce devesse falar com o sabich\xE3o ali pr\xF3ximo aquele varal, pode ser
    que ele possa te ajudar com isso."
  obraPremio: {fileID: 11400000, guid: c1c8faf2de23e9d4995d30486f89b46f, type: 2}
