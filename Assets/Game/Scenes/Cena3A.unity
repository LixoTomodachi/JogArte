  indicadorInteracao: {fileID: 0}
  nomeCenaDestino: 
  animatorPersonagemEmCena: {fileID: 1119135482}
  triggerAnimacao: Interact
  painelDialogo: {fileID: 218523841}
  textoDialogo: {fileID: 1720255076}
  falas:
  - "Ol\xE1 querido(a). Sou a Marjorie! Seja bem vindo(a) ao Departamento de Artes
    Visuais e Design!"
  - "Sou a orientadora do Victor, aquele que te trouxe at\xE9 aqui. Como sempre,
    aparece e some do nada.\nAcredito que ele deva ter vindo falando sobre tudo,
    menos onde ativar as coisas, n\xE9?"
  - "Enfim, estou aqui para te orientar tamb\xE9m.\n*risos*"
  - "No laborat\xF3rio de Bidi (mesas mais a frente), na segunda mesa, voc\xEA ver\xE1
    um bloco de papel e tintas guache de potinho."
  - "Voc\xEA pode ativar a Isopografia l\xE1."
  - "Al\xE9m disso, mais \xE0 frente voc\xEA conhecer\xE1 a Pamy e a Suyane. Elas
    tamb\xE9m v\xE3o te dizer algo. Sugiro que fale com elas."
  - Xerinho!
  perguntaID: 
  questionPanel: {fileID: 0}
  questionText: {fileID: 0}
  enunciadoPergunta: 
